# Copy to .env — NEVER commit the real file.
# The previous .env was committed to a public repository; those values are
# compromised and must be rotated before this server is used.

PORT=8080

# Server-side Supabase. The SERVICE ROLE key bypasses row level security and
# must never reach the browser bundle.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay. The key secret is server-only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
